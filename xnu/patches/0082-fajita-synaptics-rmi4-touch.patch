+static int
+touch_synaptics(void)
+{
+	uint8_t buf[90];
+	unsigned req_len = st.data1_offset + TOUCH_MAX * 8u;
+	int err = touch_read(TOUCH_SLAVE_ADDR, st.f12_data, false, buf, req_len);
+	if (err) {
+		return err;
+	}
+
+	uint32_t mask = 0;
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	const uint8_t *data1 = buf + st.data1_offset;
+
+	for (unsigned i = 0; i < TOUCH_MAX; ++i) {
+		const uint8_t *f = data1 + i * 8u;
+		uint8_t obj_type = f[0] & 0x03u;
+		if (obj_type == 1u || obj_type == 2u) {
+			uint16_t px = (uint16_t)f[1] | ((uint16_t)f[2] << 8u);
+			uint16_t py = (uint16_t)f[3] | ((uint16_t)f[4] << 8u);
