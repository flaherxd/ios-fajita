+static bool
+touch_scan_pdt(void)
+{
+	/* Select Page 0 with retry */
+	int err = -1;
+	for (unsigned r = 0; r < 5; ++r) {
+		err = touch_write_reg(TOUCH_SLAVE_ADDR, 0xffu, 0x00u);
+		if (!err) break;
+		touch_wait(20);
+	}
+	if (err) {
+		printf("SWEET TOUCH: select page 0 failed %d\n", err);
+		return false;
+	}
+
+	st.has_f01 = false;
+	st.has_f12 = false;
+
+	/* Scan Page Description Table backwards from 0x00e9 down to 0x0005 */
+	for (int addr = 0x00e9; addr >= 0x0005; addr -= 6) {
+		uint8_t pdt[6] = {0};
+		err = touch_read(TOUCH_SLAVE_ADDR, (uint16_t)addr, false, pdt, 6);
+		if (err) {
+			printf("SWEET TOUCH: PDT read at %#x failed %d\n", addr, err);
+			break;
+		}
+		uint8_t fn = pdt[5];
+		if (fn == 0x00u) {
+			break; /* End of PDT table */
+		}
+		printf("SWEET TOUCH: PDT fn=%02x q=%02x cmd=%02x ctrl=%02x data=%02x int=%02x\n",
+		    fn, pdt[0], pdt[1], pdt[2], pdt[3], pdt[4]);
+		if (fn == 0x01u) {
+			st.f01_query = pdt[0];
+			st.f01_cmd = pdt[1];
+			st.f01_ctrl = pdt[2];
+			st.f01_data = pdt[3];
+			st.has_f01 = true;
+		} else if (fn == 0x12u) {
+			st.f12_query = pdt[0];
+			st.f12_cmd = pdt[1];
+			st.f12_ctrl = pdt[2];
+			st.f12_data = pdt[3];
+			st.has_f12 = true;
+		}
+	}
+
+	if (!st.has_f12) {
+		printf("SWEET TOUCH: F12 not found in PDT, using fallback F12 data=0x01\n");
+		st.f12_data = 0x01u;
+		st.data1_offset = 0u;
+		st.has_f12 = true;
+	} else {
+		/* Read Query 8 to determine if data0 is present */
+		uint8_t q8 = 0;
+		err = touch_read(TOUCH_SLAVE_ADDR, st.f12_query + 8u, false, &q8, 1);
+		if (!err && (q8 & 1u)) {
+			st.data1_offset = 1u;
+		} else {
+			st.data1_offset = 0u;
+		}
+		printf("SWEET TOUCH: F12 data1_offset=%u (q8=%#x, err=%d)\n", st.data1_offset, q8, err);
+	}
+
+	/* Un-sleep device via F01 control (sleep mode 0 = normal) */
+	if (st.has_f01) {
+		touch_write_reg(TOUCH_SLAVE_ADDR, st.f01_ctrl, 0u);
+		uint8_t status[2] = {0};
+		touch_read(TOUCH_SLAVE_ADDR, st.f01_data, false, status, 2);
+		printf("SWEET TOUCH: F01 dev_status=%#x irq_status=%#x\n", status[0], status[1]);
+	}
+
+	return true;
+}
